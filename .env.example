# Copiez ce fichier en ".env" puis renseignez vos valeurs. Ne publiez jamais le fichier ".env".
#
# ID du formulaire Formspree (https://formspree.io) – gratuit jusqu'à 50 messages/mois.
# Exemple : si l'URL de votre formulaire est https://formspree.io/f/xyzabcde, saisissez : xyzabcde
# Laissez vide pour utiliser le mode de secours : le bouton "Envoyer" ouvre votre messagerie
# avec le message déjà rédigé.
VITE_FORMSPREE_ID=

# Adresse publique du site (utilisée pour le SEO, le sitemap et les liens de partage).
VITE_SITE_URL=https://meyra.example
